#!/usr/bin/env bash
# Reports this agent's status to the hub: agent-status STATUS [MESSAGE...]
#   STATUS: working | blocked | idle | done
#   AGENTHUBCTL_URL, AGENTHUBCTL_AGENT: set by the demo container
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: agent-status working|blocked|idle|done [MESSAGE...]" >&2
    exit 2
fi
status="$1"
shift
message="$*"

# JSON-escape the message: backslashes and double quotes
message="${message//\\/\\\\}"
message="${message//\"/\\\"}"
if [[ -n "${message}" ]]; then
    body="{\"status\":\"${status}\",\"message\":\"${message}\"}"
else
    body="{\"status\":\"${status}\"}"
fi

if curl --silent --show-error --fail --max-time 5 \
    --request POST \
    --header "Content-Type: application/json" \
    --data "${body}" \
    "${AGENTHUBCTL_URL}/agents/${AGENTHUBCTL_AGENT}/status"; then
    echo "reported ${AGENTHUBCTL_AGENT}: ${status}${message:+ - $*}"
else
    echo "could not report to ${AGENTHUBCTL_URL}" >&2
    exit 1
fi
