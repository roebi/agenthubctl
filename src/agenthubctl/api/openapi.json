{
  "openapi": "3.0.3",
  "info": {
    "title": "agenthubctl",
    "version": "0.1.0"
  },
  "paths": {
    "/agents": {
      "get": {
        "operationId": "list_agents",
        "responses": {
          "200": {
            "description": "All agent statuses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AgentStatus" }
                }
              }
            }
          }
        }
      }
    },
    "/agents/{name}": {
      "get": {
        "operationId": "get_agent",
        "parameters": [{ "$ref": "#/components/parameters/AgentName" }],
        "responses": {
          "200": {
            "description": "Single agent status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AgentStatus" }
              }
            }
          },
          "400": { "description": "Invalid agent name" },
          "404": { "description": "Agent not found" }
        }
      }
    },
    "/agents/{name}/status": {
      "post": {
        "operationId": "report_agent_status",
        "parameters": [{ "$ref": "#/components/parameters/AgentName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StatusReport" }
            }
          }
        },
        "responses": {
          "204": { "description": "Status recorded" },
          "400": { "description": "Invalid agent name or body" }
        }
      }
    },
    "/agents/{name}/hook": {
      "post": {
        "operationId": "report_agent_hook",
        "description": "Event-driven status collection (FR-05): accepts a raw Claude Code hook payload as sent on the hook's stdin and translates it into a status: SessionStart -> idle, UserPromptSubmit and PreToolUse -> working, Notification -> blocked (with its message), Stop -> done. Other events are accepted and ignored.",
        "parameters": [{ "$ref": "#/components/parameters/AgentName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HookPayload" }
            }
          }
        },
        "responses": {
          "204": { "description": "Hook event processed" },
          "400": { "description": "Invalid agent name or body" }
        }
      }
    },
    "/agents/{name}/terminal": {
      "get": {
        "operationId": "get_agent_terminal",
        "parameters": [{ "$ref": "#/components/parameters/AgentName" }],
        "responses": {
          "200": {
            "description": "Terminal endpoint for the agent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TerminalEndpoint" }
              }
            }
          },
          "400": { "description": "Invalid agent name" },
          "404": { "description": "Agent not found" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AgentName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/AgentName" }
      }
    },
    "schemas": {
      "AgentName": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "AgentStatus": {
        "type": "object",
        "required": ["name", "status", "timestamp"],
        "properties": {
          "name": { "$ref": "#/components/schemas/AgentName" },
          "status": {
            "type": "string",
            "enum": ["working", "blocked", "idle", "done"]
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "message": { "type": "string", "nullable": true }
        }
      },
      "StatusReport": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["working", "blocked", "idle", "done"]
          },
          "message": { "type": "string", "nullable": true }
        }
      },
      "HookPayload": {
        "type": "object",
        "required": ["hook_event_name"],
        "properties": {
          "hook_event_name": { "type": "string" }
        },
        "additionalProperties": true
      },
      "TerminalEndpoint": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" }
        }
      }
    }
  }
}
